# ========================================================
# Unified Business Finance Dashboard (UBFD) Configuration
# ========================================================

# Security
SECRET_KEY=ubfd-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite async local, PostgreSQL in production)
DATABASE_URL=sqlite+aiosqlite:///./ubfd.db

# Live Cellular SMS Gateway (To send physical SMS to +91 mobile numbers)
# Option 1: Fast2SMS (Indian Gateway - Free API Key at https://www.fast2sms.com)
FAST2SMS_API_KEY=

# Option 2: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# RBI Account Aggregator Gateway (Setu FIU / Finvu)
AA_PROVIDER=SANDBOX
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_BASE_URL=https://fiu-sandbox.setu.co
